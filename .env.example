# Copy to .env and fill in. With no key everything runs in deterministic offline mode.

# Meta Model API (OpenAI compatible)
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Model ids
MUSE_SPARK_MODEL=muse-spark-1.2
MUSE_CODE_MODEL=muse-spark-1.2
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1
MUSE_REASONING_EFFORT=medium

# Endpoint overrides. Defaults: SAM 3.1 -> {base}/responses, Muse Image -> {base}/images/edits
SAM_URL=
MUSE_IMAGE_URL=
# live SAM is billed per frame: how many in-transit frames to check per seed
AEGIS_SAM_MAX_CARRY=3

MUSE_VOICE_MODEL=muse-voice-transcribe-1.0

# Muse Code CLI as the policy writer, run headless with `muse exec` inside a scratch folder that holds
# policy.py and TASK.md. {task} and {dir} are filled in per call. Its own OS sandbox is off because it only
# edits one temp file and the generated policy still runs in the Aegis sandbox.
# MUSE_CODE_CMD=muse --approval-mode never --disable-sandbox --disable-request-user-input --reasoning-effort medium --contributor-mode off --workspace "{dir}" exec "{task}"
MUSE_CODE_CMD=

# Muse Spark Open (red-team attacker) on a hosted provider with an OpenAI-compatible API.
# Copy base URL, key and model id from your provider's model page, e.g.
#   Fireworks: https://api.fireworks.ai/inference/v1     Baseten: https://inference.baseten.co/v1
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
SPARK_OPEN_MODEL=
AEGIS_REDTEAM_N=3

# Muse Glimmer (edge fallback) served on this machine, e.g. llama.cpp -> http://localhost:8080/v1,
# vLLM -> http://localhost:8000/v1, Ollama -> http://localhost:11434/v1
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=muse-glimmer

# live | offline. Leave empty to go live whenever MODEL_API_KEY is set.
AEGIS_MODE=
# Per component override, e.g. keep SAM offline while Spark and Code are live
AEGIS_SAM_BACKEND=
AEGIS_WONDER_BACKEND=
AEGIS_IMAGE_BACKEND=
AEGIS_VOICE_BACKEND=
AEGIS_SPARK_OPEN_BACKEND=
AEGIS_GLIMMER_BACKEND=
AEGIS_SPARK_BACKEND=
AEGIS_CODE_BACKEND=

# local | modal
AEGIS_SANDBOX=local
AEGIS_MAX_ITERS=4
